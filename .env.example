# --- Local Supabase (Docker via `npx supabase start`) ---
# The URL is always http://127.0.0.1:54321 (configurable in supabase/config.toml).
# The publishable key is unique to your machine — get it from `npx supabase start` output.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# --- Cloud Supabase (uncomment and fill in when needed) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
